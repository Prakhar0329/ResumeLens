# ResumeLens backend configuration.
# Copy to `.env` (in the backend/ directory) and adjust. Every value shown is the default.

# --- General ---------------------------------------------------------------
APP_NAME=ResumeLens
APP_VERSION=1.0.0
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Storage ----------------------------------------------------------------
# Leave unset to use backend/data/resumelens.db (created automatically).
# Use four slashes for an absolute path, e.g. sqlite:////app/data/resumelens.db
# DATABASE_URL=sqlite:///./data/resumelens.db

# --- HTTP ---------------------------------------------------------------------
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_ENABLED=true
# Applies separately to /analyze and /rewrite-bullet, per client IP.
RATE_LIMIT_PER_MINUTE=20

# --- Models -------------------------------------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
# Where sentence-transformers caches downloaded models (empty = library default).
# MODEL_CACHE_DIR=
SPACY_MODEL=en_core_web_sm
# Load the embedding model at startup (true) or lazily on the first request (false).
PRELOAD_MODELS=true

# --- Input limits -------------------------------------------------------------
MAX_UPLOAD_MB=5
MAX_PDF_PAGES=10
MIN_JD_CHARS=100
MAX_JD_CHARS=15000

# --- Chunking / output sizes -----------------------------------------------------
CHUNK_MIN_WORDS=15
CHUNK_MAX_WORDS=80
MAX_JD_REQUIREMENTS=60
TOP_REQUIREMENT_MATCHES=10
MAX_EXTRA_SKILLS=15

# --- Scoring weights (normalised to sum to 1) ------------------------------------
WEIGHT_SKILL=0.50
WEIGHT_SEMANTIC=0.35
WEIGHT_KEYWORD=0.15

# Skill-coverage weight per JD requirement type.
SKILL_WEIGHT_REQUIRED=2.0
SKILL_WEIGHT_UNSPECIFIED=1.0
SKILL_WEIGHT_PREFERRED=0.5

# Raw cosine -> 0..100 rescaling bands (calibrate with evaluation/evaluate.py).
SEMANTIC_FLOOR=0.20
SEMANTIC_CEILING=0.75
KEYWORD_FLOOR=0.02
KEYWORD_CEILING=0.40

# --- Optional LLM bullet rewriter -------------------------------------------------
# Leave empty to disable; POST /api/v1/rewrite-bullet then returns HTTP 501.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
LLM_MAX_TOKENS=300
LLM_TIMEOUT_SECONDS=30
