# Settings read by docker-compose.yml. Copy to `.env` in the repository root.
# (Running without Docker? Use backend/.env and frontend/.env.local instead.)

# Browser origin(s) allowed to call the API, comma-separated.
CORS_ORIGINS=http://localhost:3000
# URL the browser uses to reach the API. Changing it requires `docker compose up --build`.
NEXT_PUBLIC_API_URL=http://localhost:8000

LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=20
WEIGHT_SKILL=0.50
WEIGHT_SEMANTIC=0.35
WEIGHT_KEYWORD=0.15

# Optional bullet rewriter. Leave empty to disable (the endpoint returns 501).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
