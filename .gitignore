# ---- Secrets and local config ----
.env
.env.*
!.env.example
!.env.local.example
**/.env
**/.env.local

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---- SQLite database ----
backend/data/*
!backend/data/.gitkeep
*.db
*.db-journal
*.db-wal
*.db-shm

# ---- Model caches ----
.cache/
models/
**/huggingface/
**/sentence_transformers/

# ---- Evaluation: keep templates and docs, never resumes or outputs ----
backend/evaluation/data/*
