backend/evaluation/results.md
backend/evaluation/results.csv
backend/evaluation/per_pair_scores.csv

# ---- Node / Next.js ----
node_modules/
.next/
out/
frontend/coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel

# ---- OS / editors ----
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
